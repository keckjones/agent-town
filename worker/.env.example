# Copy each of these into Railway → your service → Variables.
# Never commit real keys to GitHub.

# --- Required ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # Supabase → Project Settings → API → service_role (secret!)
ANTHROPIC_API_KEY=                # console.anthropic.com → API Keys
GOOGLE_API_KEY=                   # Google Cloud → Credentials (enable Places API (New) + PageSpeed Insights API)

# --- Your business (required before any email is sent; CAN-SPAM) ---
BUSINESS_NAME=
SENDER_NAME=
BUSINESS_ADDRESS=                 # a real mailing address (a PO box or virtual mailbox works)
BUSINESS_PHONE=
BUSINESS_WEBSITE=

# --- Email (sends from agentickj@gmail.com by default) ---
SMTP_PASS=                        # Google Account → Security → App passwords (16 characters)
# SMTP_USER=agentickj@gmail.com
# SMTP_HOST=smtp.gmail.com

# --- Morning text (Twilio; A2P 10DLC registration required) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Payments / commerce / data (add as you connect each) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ETSY_API_KEY=
ETSY_SHARED_SECRET=
PRINTFUL_TOKEN=
SHOPIFY_STORE=                    # your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
RENTCAST_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=           # YouTube channel connections
GOOGLE_OAUTH_CLIENT_SECRET=

# --- KJ's Picks feed ---
SPORTS_SUPABASE_URL=
SPORTS_SUPABASE_ANON_KEY=
SPORTS_EMAIL=
SPORTS_PASSWORD=
SPORTS_SITE_URL=

# --- Links ---
BOOKING_URL=
DASHBOARD_URL=
# PUBLIC_URL is set automatically from Railway's generated domain.

# --- Optional ---
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_CHEAP_MODEL=claude-haiku-4-5-20251001
# MANAGER_CRON=0 */3 * * *        # how often the manager holds a town meeting
# CONCURRENCY=2
# TASK_TIMEOUT_MIN=12
