# Copy each of these into Railway → your service → Variables.
# Never commit real keys to GitHub.

# --- Required ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # Supabase → Project Settings → API → service_role (secret!)
ANTHROPIC_API_KEY=                # console.anthropic.com → API Keys
GOOGLE_API_KEY=                   # Google Cloud → Credentials (enable Places API (New) + PageSpeed Insights API)

# --- Your business (required before any email is sent; CAN-SPAM) ---
BUSINESS_NAME=
SENDER_NAME=
BUSINESS_ADDRESS=                 # a real mailing address (a PO box or virtual mailbox works)
BUSINESS_PHONE=
BUSINESS_WEBSITE=

# --- Outreach email (add once you have the outreach domain + mailbox) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=                        # Google Workspace: create an App Password
SMTP_FROM=

# --- Optional ---
# SHOPIFY_STORE=your-store.myshopify.com
# SHOPIFY_ADMIN_TOKEN=
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_CHEAP_MODEL=claude-haiku-4-5-20251001
# MANAGER_CRON=0 */3 * * *        # how often the manager holds a town meeting
# CONCURRENCY=2
